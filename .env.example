# =============================================================================
# Online Ride-Hailing DevOps Platform - Environment Configuration Template
# COPY THIS FILE TO .env BEFORE RUNNING: docker compose up -d
# NEVER COMMIT REAL PRODUCTION CREDENTIALS OR SECRETS TO SOURCE CONTROL
# =============================================================================

# -----------------------------------------------------------------------------
# MySQL Infrastructure Configuration
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# Redis Infrastructure Configuration
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# RabbitMQ Infrastructure Configuration
# -----------------------------------------------------------------------------
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# JWT Security Configuration
# NOTE: The default value below is for LOCAL DEVELOPMENT ONLY.
# In production, supply a strong, randomly generated secret of >= 32 characters.
# -----------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# API Gateway Configuration
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20
RATE_LIMIT_REQUESTED_TOKENS=1

# -----------------------------------------------------------------------------
# Microservice Host Exposed Ports (Local Development & Direct Testing)
# -----------------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
PASSENGER_SERVICE_PORT=8082
DRIVER_SERVICE_PORT=8083
RIDE_SERVICE_PORT=8084
MATCHING_SERVICE_PORT=8085
PRICING_SERVICE_PORT=8086
BILLING_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
RATING_SERVICE_PORT=8089
REPORTING_SERVICE_PORT=8090
